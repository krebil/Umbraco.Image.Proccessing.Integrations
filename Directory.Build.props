<Project>

    <!--
      The version local and non-release builds produce. All packages are versioned in lockstep
      (ADR-0001). A release does not read this value: pushing a `v*` git tag runs the publish
      workflow, which packs every package with the version taken from the tag name
      (`-p:Version=`), so `v3.2.0` ships 3.2.0 whatever this says. Keep it at the last released
      version so local packs are not mistaken for an unreleased one.
    -->
    <PropertyGroup>
        <Version>3.1.0</Version>
    </PropertyGroup>

    <!--
      Production-hardening ticket 08: escalate IDE/analyzer code-style suggestions to build-time
      warnings (and, via TreatWarningsAsErrors, build failures) so the warning/style baseline this
      ticket established does not silently regress. Without EnforceCodeStyleInBuild, style
      suggestions only show up through an explicit "dotnet format" verification run, which nothing
      runs automatically.
    -->
    <PropertyGroup>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

</Project>

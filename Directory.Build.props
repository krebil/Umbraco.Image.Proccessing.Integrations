<Project>

    <!--
      Single source of truth for the product's version. Core, SkiaSharp, ImageFlow, and
      UmbracoExtensions are versioned in lockstep — every release bumps this one value and ships
      all four packages under it, even if only one changed (ADR-0001). Bumping it is a manual
      commit; a matching `v*` git tag triggers the publish workflow.
    -->
    <PropertyGroup>
        <Version>1.0.0</Version>
    </PropertyGroup>

    <!--
      Production-hardening ticket 08: escalate IDE/analyzer code-style suggestions to build-time
      warnings (and, via TreatWarningsAsErrors, build failures) so the warning/style baseline this
      ticket established does not silently regress. Without EnforceCodeStyleInBuild, style
      suggestions only show up through an explicit "dotnet format" verification run, which nothing
      runs automatically.
    -->
    <PropertyGroup>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

</Project>

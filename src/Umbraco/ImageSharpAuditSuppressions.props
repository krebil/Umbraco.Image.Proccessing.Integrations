<Project>
  <!--
    Umbraco.Cms 18.x depends on SixLabors.ImageSharp 3.1.12, and every 3.x is affected by the advisories below.
    The first patched release is 4.1.2, which Umbraco is not built for (ImageSharp.Web 4 fails at startup) and
    which needs a Six Labors license key for Release builds. This sample is never packed or shipped, and any
    Umbraco 18 site carries the same version, so these exact advisories are suppressed here instead. New
    advisories still fail restore.

    Imported by Umbraco.csproj and Umbraco.Tests.csproj, the two projects that restore Umbraco.Cms.
    Remove this file once Umbraco.Cms depends on a patched ImageSharp.
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
  </ItemGroup>
</Project>

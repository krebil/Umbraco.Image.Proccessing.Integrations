<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Reference implementation, never published as a package. -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!--
      ImageProcessor selects which processor(s) get compiled in: "SkiaSharp", "ImageFlow", or the
      default "All" (today's behavior — both, switched at runtime via ImageProcessing:Processor).
      Pass -p:ImageProcessor=SkiaSharp (or ImageFlow) to dotnet build/publish, or the matching
      Dockerfile ARG, for a smaller single-processor binary without a second project/service to
      maintain — see Program.cs for the corresponding #if gating.
    -->
    <PropertyGroup>
        <ImageProcessor Condition="'$(ImageProcessor)' == ''">All</ImageProcessor>
        <DefineConstants Condition="'$(ImageProcessor)' != 'ImageFlow'">$(DefineConstants);INCLUDE_SKIASHARP</DefineConstants>
        <DefineConstants Condition="'$(ImageProcessor)' != 'SkiaSharp'">$(DefineConstants);INCLUDE_IMAGEFLOW</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Umbraco.Image.Processing.Core\Umbraco.Image.Processing.Core\Umbraco.Image.Processing.Core.csproj" />
        <ProjectReference Include="..\..\Umbraco.Image.Processing.SkiaSharp\Umbraco.Image.Processing.SkiaSharp\Umbraco.Image.Processing.SkiaSharp.csproj" Condition="'$(ImageProcessor)' != 'ImageFlow'" />
        <ProjectReference Include="..\..\Umbraco.Image.Processing.ImageFlow\Umbraco.Image.Processing.ImageFlow\Umbraco.Image.Processing.ImageFlow.csproj" Condition="'$(ImageProcessor)' != 'SkiaSharp'" />
        <ProjectReference Include="..\..\Umbraco.Image.Processing.AzureBlob\Umbraco.Image.Processing.AzureBlob\Umbraco.Image.Processing.AzureBlob.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Umbraco.Image.Processing.Service.Tests" />
    </ItemGroup>

    <!-- Optional telemetry (Telemetry.cs): inert unless an exporter is configured. -->
    <ItemGroup>
        <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
    </ItemGroup>

</Project>

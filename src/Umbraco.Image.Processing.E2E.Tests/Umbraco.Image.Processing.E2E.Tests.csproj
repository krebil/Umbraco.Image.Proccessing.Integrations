<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.Testing" Version="13.5.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
        <PackageReference Include="SkiaSharp" Version="4.151.1" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.151.1" />
        <PackageReference Include="xunit" Version="2.9.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <!-- Referenced only so DistributedApplicationTestingBuilder.CreateAsync<Projects.Umbraco_Image_Processing_AppHost>()
             has a type-safe entry point into the real product AppHost graph (umbraco + image-processing-service + storage/blobs),
             the same mechanism AzureBlob.TestHost provides for ticket 05, but here against the real AppHost rather than a
             stand-in: this suite's whole point is exercising the real multi-process graph, not a subset of it. -->
        <ProjectReference Include="..\Umbraco.Image.Processing.AppHost\Umbraco.Image.Processing.AppHost\Umbraco.Image.Processing.AppHost.csproj" />
        <ProjectReference Include="..\Umbraco.Image.Processing.Core\Umbraco.Image.Processing.Core\Umbraco.Image.Processing.Core.csproj" />
        <ProjectReference Include="..\Umbraco.Image.Processing.UmbracoExtensions\Umbraco.Image.Processing.UmbracoExtensions\Umbraco.Image.Processing.UmbracoExtensions.csproj" />
    </ItemGroup>

</Project>

# Copy this file to .env (gitignored) and uncomment the lines you need.
# AppHost.cs loads .env at startup and applies it as process environment variables,
# so these use the double-underscore convention (Key__SubKey), same as env vars.

# ImageProcessing:Mode - InProcess (default) or Standalone
#ImageProcessing__Mode=Standalone

# Storage:Mode - LocalDisk (default), AzureBlob, or HttpProxy
#Storage__Mode=AzureBlob

# ImageProcessing:Processor - SkiaSharp or ImageFlow (both projects default to ImageFlow)
#ImageProcessing__Processor=SkiaSharp

# Override Umbraco's database connection string (normally uses the checked-in SQLite file)
#ConnectionStrings__umbracoDbDSN=
